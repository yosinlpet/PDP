public class IntentionAnt implements Ant, Cloneable{
	
	private RoadModel roadModel;
	private Queue<Point> intentionPath;
	private Point position;
	
	/**
	 * Constructor
	 * @param pckg {@link Package} sending the {@link FeasabilityAnt}.
	 * @param p	location where to initialize the {@link FeasabilityAnt}.
	 **/
	public IntentionAnt(AgvAgent agent, LinkedList<Point> intentionPath) {
		this.intentionPath = intentionPath;
		this.position = intentionPath.poll(); 
	}

	@Override
	public void initRoadUser(RoadModel model) {
		roadModel = model;
	}

	/**
	 * Leaves intention flag on the {@link RoadModel}.
	 */
	public void dropFlag(){
		IntentionFlag flag = new IntentionFlag();	
		roadModel.addObjectAt(flag, position);
	}
	
	public void hop() {
		position = intentionPath.poll();
	}
	
	// Is there a flag yet?
	public boolean flagged() {
		
		
	}
	
	public void removeFlag() {
		
	}
	
	// Go two hops ahead
	public void run() {
		hop();
		if(!flagged()) {
			dropFlag();
			hop();
			if(!flagged())
				dropFlag();
		}
		
		
	}
	
}