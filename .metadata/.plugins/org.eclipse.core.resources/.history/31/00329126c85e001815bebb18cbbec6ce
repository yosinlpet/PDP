/**
 * RoadSigns are information dropped by {@link FeasabilityAnt}s; each sign carries
 * info about where to go to find a {@link Pack} and when it expires.
 * It has to die after a few ticks
 */
public class RoadSign implements RoadUser, TickListener {
    
	private Optional<CollisionGraphRoadModelImpl> roadModel;
    private Pack pack;
    private Point next;
    private int cost;
    private TimeWindow timeWindow;
    private boolean intentionGiven; 
    private boolean wantIntention;
    private TimeWindow twIntention;
    
    public RoadSign(Pack pack, LinkedList<Point> path, TimeWindow timeWindow){
        roadModel = Optional.absent();
        this.timeWindow = timeWindow;
        this.pack = pack;
        LinkedList<Point> path_ = path;
        cost = path.size();
        path_.removeLast();
        next = path_.getLast();
        intentionGiven = false;
        wantIntention = false;
    }

    @Override
    public void initRoadUser(RoadModel model){
        roadModel = Optional.of((CollisionGraphRoadModelImpl) model);
    }
    
    public void wantIntention() {
    	wantIntention = true;
    }
    
    public void giveIntention(TimeLapse timeLapse) {
    	twIntention = TimeWindow.create(timeLapse.getTime(), end);
    	intentionGiven = true;
    }

    public Pack getPack() {
        return pack;
    }

    public Point getNext() {
        return next;
    }

    public long getPackExpirationTime() {
        return pack.getTimeWindow().end();
    }
    @Override
    public void tick(TimeLapse timeLapse)
    {
       if (timeLapse.getTime() > timeWindow.end())
            roadModel.get().removeObject(this);
       
       if(wantIntention && !intentionGiven) {
    	   giveIntention(timeLapse);
       }
       
       if(twIntention.isIn(timeLapse.getTime())){
    	   
       }
    }
    @Override
    public void afterTick(TimeLapse timeLapse){}

    public int getCost(){
        return cost;
    }
}
