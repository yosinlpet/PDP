package kuleuven.be.PDPProject.agent;

import java.util.Set;
import java.util.LinkedList;

import com.github.rinde.rinsim.core.model.pdp.PDPModel;
import com.github.rinde.rinsim.core.model.pdp.Parcel;
import com.github.rinde.rinsim.core.model.pdp.Vehicle;
import com.github.rinde.rinsim.core.model.pdp.VehicleDTO;
import com.github.rinde.rinsim.core.model.road.RoadModel;
import com.github.rinde.rinsim.core.model.road.RoadModels;
import com.github.rinde.rinsim.core.model.road.RoadUser;
import com.github.rinde.rinsim.core.model.time.TimeLapse;
import com.github.rinde.rinsim.geom.Point;
import com.google.common.base.Optional;

/**
 * Implementation of a very simple taxi agent. It moves to the closest customer,
 * picks it up, then delivers it, repeat.
 *
 * @author Rinde van Lon
 */
public class Truck extends Vehicle {
  private static final double SPEED = 1000d;
  private Optional<Pack> curr;
  
  private IntentionAnt intAnt;
  private boolean hasSetIntention;
  private boolean hasChosenRandNeigh;
  
  private LinkedList<Point> intPath;

  public Truck(Point startPosition, int capacity) {
    super(VehicleDTO.builder()
      .capacity(capacity)
      .startPosition(startPosition)
      .speed(SPEED)
      .build());
    curr = Optional.absent();
    
    hasSetIntention = false;
    hasChosenRandNeigh = false;
  }
  
  public LinkedList<Point> selectPackPath(Set<RoadSign> rsSet) {
	  int minCost=Integer.MAX_VALUE;
	  LinkedList<Point> minPath;
	  for(RoadSign r : rsSet) {
		  if(!r.indicateDest() && r.getCost() < minCost) {
			  minPath = r.getPath();
			  hasSetIntention = true;
		  }
			  rm.moveTo(this, intPath.getFirst(), time);
			  curr = Optional.fromNullable(r.getPack());
			  break;
		  }
	  }
	  return
  }
  
  
  @Override
  public void afterTick(TimeLapse timeLapse) {}

  @Override
  protected void tickImpl(TimeLapse time) {
    final RoadModel rm = getRoadModel();
    final PDPModel pm = getPDPModel();
    
    // If no pack in target
    if (!curr.isPresent()) {
    	 Set<RoadSign> rs = rm.getObjectsAt((RoadUser) this, RoadSign.class);
    	 if(rs.isEmpty()) { // Move to a random neigh ?
    		 }
    	 else {
    		 LinkedList<Point> path =  selectPackPath(rs);
    	 }
    }
    
    if(curr.isPresent()) {
    	final boolean inCargo = pm.containerContains(this, curr.get());
    	
    	// Sanity check
        if (!inCargo && !rm.containsObject(curr.get())) {
            curr = Optional.absent();
          } 
        // We transport the pack
        else if (inCargo) {
        	  rm.moveTo(this, intPath.getFirst(), time);
              if (rm.getPosition(this).equals(curr.get().getDeliveryLocation())) {
                  // deliver when we arrive
                  pm.deliver(this, curr.get(), time);
                }
          } 
        // We go to the pack
        else {
          	rm.moveTo(this, intPath.getFirst(), time);
        	if(rm.equalPosition(this, curr.get())) {
        		pm.pickup(this, curr.get(), time);
        		Set<RoadSign> rs = rm.getObjectsAt((RoadUser) this, RoadSign.class);
	       		 for(RoadSign r : rs) {
	    			 if(r.indicateDest()) { // Be more precise!!
		    			 intPath = r.getPath();
		    			 rm.moveTo(this, intPath.getFirst(), time);
	    			 }
	    		 }
        	}
          }
    	}
    }
}
